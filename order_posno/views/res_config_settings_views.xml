<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Einstellungen für Positionsnummern -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.order.posno</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pricing_setting_container']" position="after">
                    <block title="Positionsnummern" name="posno_setting_container">
                        <setting string="Standard-Schrittweite" help="Legt die Standard-Schrittweite für automatische Positionsnummerierung fest">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="posno_increment" class="col-lg-3 o_light_label"/>
                                    <field name="posno_increment"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
