<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Erweitere die Sale Order Line Tree View -->
        <record id="view_order_line_tree_positionno" model="ir.ui.view">
            <field name="name">sale.order.line.tree.positionno</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_tree"/>
            <field name="arch" type="xml">
                <field name="order_id" position="before">
                    <field name="positionno" string="Pos.Nr." optional="show"/>
                </field>
            </field>
        </record>

        <!-- Erweiterte Search View mit Filtern und Gruppierungen -->
        <record id="view_order_line_search_positionno" model="ir.ui.view">
            <field name="name">sale.order.line.search.positionno</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
            <field name="arch" type="xml">
                <!-- Füge neue Filter hinzu -->
                <filter name="to_invoice" position="after">
                    <separator/>
                    <filter string="Vollständig geliefert" name="fully_delivered" 
                            domain="[('qty_delivered','>=','product_uom_qty'),('product_uom_qty','>',0)]"/>
                    <filter string="Teilweise geliefert" name="partially_delivered" 
                            domain="[('qty_delivered','>',0),('qty_delivered','&lt;','product_uom_qty')]"/>
                    <filter string="Nicht geliefert" name="not_delivered" 
                            domain="[('qty_delivered','=',0),('product_uom_qty','>',0)]"/>
                    <separator/>
                    <filter string="Vollständig abgerechnet" name="fully_invoiced" 
                            domain="[('qty_invoiced','>=','product_uom_qty'),('product_uom_qty','>',0)]"/>
                    <filter string="Teilweise abgerechnet" name="partially_invoiced" 
                            domain="[('qty_invoiced','>',0),('qty_invoiced','&lt;','product_uom_qty')]"/>
                    <filter string="Nicht abgerechnet" name="not_invoiced" 
                            domain="[('qty_invoiced','=',0)]"/>
                </filter>
                
                <!-- Erweitere Gruppierungen -->
                <filter name="salesperson" position="after">
                    <separator/>
                    <filter string="Rechnungsstatus" name="group_invoice_status" domain="[]" context="{'group_by':'invoice_status'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by':'state'}"/>
                </filter>
            </field>
        </record>

        <!-- Erweitere die Sale Order Form View - inline list -->
        <record id="view_order_form_positionno" model="ir.ui.view">
            <field name="name">sale.order.form.positionno</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list//field[@name='sequence']" position="after">
                    <field name="positionno" string="Pos.Nr." optional="show"/>
                </xpath>
                <!-- Smart Button für Positionen-Ansicht -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_order_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-ol">
                        <field name="order_line" widget="statinfo" string="Positionen"/>
                    </button>
                </xpath>
                <!-- Button für Neuberechnung der Positionsnummern in der Notebook-Seite -->
                <xpath expr="//page[@name='order_lines']//field[@name='order_line']" position="before">
                    <button name="action_renumber_positions" 
                            string="Positionen neu nummerieren" 
                            type="object" 
                            class="btn-link"
                            icon="fa-sort-numeric-asc"
                            help="Nummeriert alle Positionen basierend auf der aktuellen Reihenfolge neu"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
